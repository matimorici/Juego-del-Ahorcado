@page
@model IndexModel
@{
    ViewData["Title"] = "Ahorcado";
}

<div class="text-center">
    <h1 class="display-4">Ahorcado</h1>
    <p data-testid="word">@Model.PalabraEnmascarada</p>
    <p>Vidas: <span data-testid="lives">@Model.Vidas</span></p>
    <p data-testid="message">@Model.Mensaje</p>
    <p class="visually-hidden">Muñeco: <span data-testid="figure">@Model.Muneco</span></p>
    <svg viewBox="0 0 120 150" width="160" role="img" aria-label="Muñeco del ahorcado">
        <line x1="10" y1="145" x2="70" y2="145" stroke="currentColor" stroke-width="4" />
        <line x1="30" y1="145" x2="30" y2="10" stroke="currentColor" stroke-width="4" />
        <line x1="30" y1="10" x2="85" y2="10" stroke="currentColor" stroke-width="4" />
        <line x1="85" y1="10" x2="85" y2="30" stroke="currentColor" stroke-width="3" />
        @if (Model.Partes.Contains("Cabeza"))
        {
            <circle cx="85" cy="42" r="12" fill="none" stroke="currentColor" stroke-width="3" />
        }
        @if (Model.Partes.Contains("Torso"))
        {
            <line x1="85" y1="54" x2="85" y2="95" stroke="currentColor" stroke-width="3" />
        }
        @if (Model.Partes.Contains("Brazo izquierdo"))
        {
            <line x1="85" y1="65" x2="65" y2="82" stroke="currentColor" stroke-width="3" />
        }
        @if (Model.Partes.Contains("Brazo derecho"))
        {
            <line x1="85" y1="65" x2="105" y2="82" stroke="currentColor" stroke-width="3" />
        }
        @if (Model.Partes.Contains("Pierna izquierda"))
        {
            <line x1="85" y1="95" x2="68" y2="125" stroke="currentColor" stroke-width="3" />
        }
        @if (Model.Partes.Contains("Pierna derecha"))
        {
            <line x1="85" y1="95" x2="102" y2="125" stroke="currentColor" stroke-width="3" />
        }
    </svg>

    <form method="get">
        <input type="hidden" name="word" value="@Model.Palabra" />
        <input type="hidden" name="level" value="@Model.Nivel" />        
        <input type="hidden" name="played" value="@Model.LetrasJugadas" />
        <label for="letter">Letra</label>
        <input type="text" id="letter" name="letter" autocomplete="off" />
        <button type="submit">Adivinar</button>
    </form>
    @if (Model.Gano)
    {
        <p data-testid="result">GANASTE</p>
    }
    else if (Model.Perdio)
    {
        <p data-testid="result">PERDISTE</p>
    }
</div>