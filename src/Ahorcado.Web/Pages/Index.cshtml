@page
@model IndexModel
@{
    ViewData["Title"] = "Ahorcado";
}

<div class="text-center">
    <h1 class="display-4">Ahorcado</h1>
    <p data-testid="word">@Model.PalabraEnmascarada</p>
    <p>Vidas: <span data-testid="lives">@Model.Vidas</span></p>
    <p data-testid="message">@Model.Mensaje</p>

    <form method="get">
        <input type="hidden" name="word" value="@Model.Palabra" />
        <input type="hidden" name="played" value="@Model.LetrasJugadas" />
        <label for="letter">Letra</label>
        <input type="text" id="letter" name="letter" autocomplete="off" />
        <button type="submit">Adivinar</button>
    </form>
    @if (Model.Gano)
    {
        <p data-testid="result">GANASTE</p>
    }
</div>